# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- Data ---
# Raw data are not committed, except the public CelesTrak TLE snapshot the paper
# uses (data/raw/tle/). The README records source URL, date and sha256.
data/raw/*
!data/raw/README.md
!data/raw/tle/
data/processed/*
!data/processed/.gitkeep

# --- Results ---
# The run directories the paper cites are committed in full (parquet and raw CSV
# included) so scripts/make_numbers.py can regenerate numbers.tex without
# re-running the experiments. Figure copies are regenerated, not committed.
results/**/*.png
results/**/*.pdf

# --- Generated output ---
# `make regenerate` writes output/numbers.tex and output/figures/ from results/.
output/

# --- Misc ---
.DS_Store
