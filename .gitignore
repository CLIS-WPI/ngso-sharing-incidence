# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- Data ---
# Raw data are not committed, except the public CelesTrak TLE snapshot the paper
# uses (data/raw/tle/). The README records source URL, date and sha256.
data/raw/*
!data/raw/README.md
!data/raw/tle/
data/processed/*
!data/processed/.gitkeep

# --- Results ---
# Run directories are reproducible: heavy artifacts stay out of git, but the
# small provenance files and summary CSVs are committed so numbers can be traced.
results/**/*.parquet
results/**/*.arrow
results/**/*.png
results/**/*.pdf
results/**/raw_*.csv

# --- Paper ---
# LaTeX build artifacts are regenerated from paper/*.tex; the PDF is a build
# product (rebuild with `make paper`).
paper/*.aux
paper/*.log
paper/*.fls
paper/*.fdb_latexmk
paper/*.out
paper/*.blg
paper/*.bbl
paper/*.bcf
paper/*.pdf

# --- Misc ---
.DS_Store
